# ══════════════════════════════════════════════════════════════
# hi-master — Environment Configuration (EXAMPLE ONLY)
# Copy this file to `.env` and fill in real values. Never commit
# the real `.env` file. All values here are placeholders.
# ══════════════════════════════════════════════════════════════

# Server
PORT=3000
NODE_ENV=development

# MongoDB connection string (Mongoose). Leave empty to use the
# in-memory/JSON storage fallback in src/db/memory.js.
MONGO_URI=mongodb://localhost:27017/njmoman

# JWT signing secret — REQUIRED in production (app fails fast without it).
# Use a long random string, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# Root admin account (Control Panel login at /cp)
ADMIN_USER=admin
ADMIN_PASS=change-me-strong-password

# CORS allowed origin. Use a comma-separated list, or * to allow all
# (NOT recommended for production).
CORS_ORIGIN=*

# Uploads
# Maximum accepted upload size in bytes (default 50 MB).
MAX_UPLOAD_BYTES=52428800

# WebRTC voice (Phase 4)
# TURN relay for peers behind strict NAT (see docker-compose.voice.yml).
# TURN_URL should be a "turn:" or "turns:" URI. Leave TURN_URL empty to fall
# back to public STUN only.
TURN_URL=
TURN_USER=
TURN_PASS=
# Comma-separated list of STUN servers.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Maximum simultaneous speakers per room (mesh WebRTC degrades past ~4).
MAX_VOICE_SPEAKERS=4

# Optional / future phases
# REDIS_URL=redis://localhost:6379

# Phase 5 — Automatic backups
# Number of most-recent backups to keep (rotation deletes older ones).
BACKUP_KEEP=20
# Interval between scheduled backups in milliseconds (default 6 hours).
BACKUP_INTERVAL_MS=21600000
# Directory where backups are stored (defaults to ./backups).
# BACKUP_DIR=F:\hi-master\backups
# Path to the mongodump binary. When empty, the app probes common install
# locations (e.g. C:\Program Files\MongoDB\Server\*\bin). If MongoDB is
# reachable but no mongodump is found, backups fall back to JSON export.
MONGODUMP_PATH=
